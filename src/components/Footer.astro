---
import { SITE_CONFIG } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">
          <img src="/assets/openbuild-logo.png" alt="" width="28" height="28" />
          <span>{SITE_CONFIG.name}</span>
        </a>
        <p class="muted" style="font-size:0.92rem;margin-top:0.7rem;">
          {SITE_CONFIG.tagline} Open-source Android development environment for mobile devices.
        </p>
      </div>

      <div>
        <strong>Product</strong>
        <ul class="footer-list">
          <li><a href="/download">Download APK</a></li>
          <li><a href="/features">Features</a></li>
          <li><a href="/documentation">Documentation</a></li>
          <li><a href="/changelog">Changelog</a></li>
        </ul>
      </div>

      <div>
        <strong>Resources</strong>
        <ul class="footer-list">
          <li><a href="/about">About</a></li>
          <li><a href="/about-openbuild">Product Facts</a></li>
          <li><a href="/android-ide">Android IDE Guide</a></li>
          <li><a href="/guides">Guides</a></li>
        </ul>
      </div>

      <div>
        <strong>Project & Legal</strong>
        <ul class="footer-list">
          <li><a href={SITE_CONFIG.github.repo} target="_blank" rel="noopener noreferrer">GitHub Repository</a></li>
          <li><a href={SITE_CONFIG.github.issues} target="_blank" rel="noopener noreferrer">Report an Issue</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Use</a></li>
          <li><a href="/cookies">Cookie Policy</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} {SITE_CONFIG.name}</span>
      <span>{SITE_CONFIG.creatorCredit}</span>
    </div>
  </div>
</footer>