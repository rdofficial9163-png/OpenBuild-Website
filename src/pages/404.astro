---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found — OpenBuild IDE" description="The requested page could not be found." noindex={true}>
  <section class="section">
    <div class="container" style="max-width:640px;">
      <h1>404 — Page Not Found</h1>
      <p class="muted">The page you requested does not exist or may have moved.</p>
      <div class="btn-group">
        <a href="/" class="btn btn-primary">Back to Homepage</a>
        <a href="/download" class="btn btn-secondary">Download OpenBuild APK</a>
      </div>
    </div>
  </section>
</BaseLayout>