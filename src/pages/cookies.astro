---
// src/pages/cookies.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Cookie Policy — OpenBuild IDE" description="Cookie and local storage disclosure for the OpenBuild IDE website.">
  <section class="section">
    <div class="container" style="max-width:760px;">
      <h1>Cookie Policy</h1>
      <p class="muted">
        The OpenBuild IDE website does not set advertising or analytics cookies. Only browser
        <code>localStorage</code> (for your light/dark theme choice) and Service Worker caching (for offline PWA support)
        are used locally on your device.
      </p>
    </div>
  </section>
</BaseLayout>