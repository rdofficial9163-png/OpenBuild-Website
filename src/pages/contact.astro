---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../data/site';
---
<BaseLayout title="Contact & Support — OpenBuild IDE" description="Report bugs, request features, or contact the OpenBuild IDE project via GitHub.">
  <section class="section">
    <div class="container" style="max-width:760px;">
      <h1>Contact &amp; Support</h1>
      <p class="lead">Bug reports, build questions, and security disclosures are handled through GitHub.</p>
      <div class="btn-group">
        <a href={SITE_CONFIG.github.issues} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Open a GitHub Issue
        </a>
        <a href={SITE_CONFIG.github.repo} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          View Repository
        </a>
      </div>
    </div>
  </section>
</BaseLayout>