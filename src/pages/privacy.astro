---
// src/pages/privacy.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy — OpenBuild IDE" description="Privacy policy for the OpenBuild IDE website.">
  <section class="section">
    <div class="container" style="max-width:760px;">
      <h1>Privacy Policy</h1>
      <p class="muted">
        This website does not run third-party advertising trackers or require user accounts.
        Your theme preference (light or dark) is stored locally in your browser via <code>localStorage</code>
        and is never transmitted to our servers.
      </p>
      <p class="muted">
        When you download the OpenBuild APK or visit GitHub links, you interact with GitHub
        and Netlify infrastructure subject to their respective privacy policies.
      </p>
    </div>
  </section>
</BaseLayout>